generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id
  name       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sessions        Session[]
  recommendations Recommendation[]
  consent         UserConsent?

  @@map("users")
}

model Session {
  id                 String        @id @default(uuid())
  user_id            String
  status             SessionStatus @default(ACTIVE)
  session_type       SessionType   @default(OTHER)
  start_time         DateTime      @default(now())
  end_time           DateTime?
  planned_duration   Int?
  actual_duration    Int?
  pause_count        Int           @default(0)
  total_break_mins   Int           @default(0)
  productivity_score Float?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pre_survey      PreSurvey?
  post_survey     PostSurvey?
  passive_signals PassiveSignal[]
  recommendations Recommendation[]

  @@map("sessions")
}

model PreSurvey {
  id              String      @id @default(uuid())
  session_id      String      @unique
  mood            Int
  energy          Int
  motivation      Int
  goal_difficulty Int
  environment     Environment @default(QUIET)
  music_type      MusicType?
  created_at      DateTime    @default(now())

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("pre_surveys")
}

model PostSurvey {
  id           String      @id @default(uuid())
  session_id   String      @unique
  productivity Int
  focus        Int
  satisfaction Int
  distraction  Distraction @default(NONE)
  notes        String?
  created_at   DateTime    @default(now())

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("post_surveys")
}

model Recommendation {
  id            String                    @id @default(uuid())
  user_id       String
  session_id    String?
  type          RecommendationType
  content       String
  reasoning     String?
  interaction   RecommendationInteraction?
  interacted_at DateTime?
  created_at    DateTime                  @default(now())

  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [session_id], references: [id], onDelete: SetNull)

  @@map("recommendations")
}

model PassiveSignal {
  id                 String   @id @default(uuid())
  session_id         String
  notification_count Int?
  distraction_taps   Int?
  unlock_count       Int?
  recorded_at        DateTime @default(now())

  session Session @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("passive_signals")
}

model UserConsent {
  id                      String   @id @default(uuid())
  user_id                 String   @unique
  notifications_enabled   Boolean  @default(false)
  distraction_tap_enabled Boolean  @default(false)
  unlock_tracking_enabled Boolean  @default(false)
  updated_at              DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ABANDONED
}

enum SessionType {
  TEST
  READING
  WRITING
  CODING
  OTHER
}

enum Environment {
  QUIET
  NOISY
  MUSIC
}

enum MusicType {
  LOFI
  CLASSICAL
  AMBIENT
  OTHER
}

enum Distraction {
  NONE
  FEW
  MANY
}

enum RecommendationType {
  TIME_OF_DAY
  DURATION
  BREAK_SCHEDULE
  ENVIRONMENT
}

enum RecommendationInteraction {
  APPLIED
  DISMISSED
}
