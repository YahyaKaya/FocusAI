# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (same one used in the backend)
SUPABASE_URL=https://vltfjbxoyrfqrmegutwl.supabase.co

# Service Role key — NOT the anon key.
# Find it in: Supabase Dashboard → Project Settings → API → service_role (secret)
# This key bypasses Row Level Security so the ML service can read all users' data.
# NEVER expose this key in the mobile app or commit it to git.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets $PORT automatically. Only set this for local dev.
PORT=8000
